<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A location foreground service lets the ride keep broadcasting position while
         backgrounded, using only the foreground ("while using") location grant. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR scanning for joining a ride. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".ConvoTrackApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="ConvoTrack"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConvoTrack">

        <!-- Maps SDK for Android key (injected from local.properties via manifestPlaceholders). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ConvoTrack"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Legacy deep link: convotrack://join/INVITECODE (QR back-compat) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="convotrack" android:host="join" />
            </intent-filter>

            <!-- HTTPS App Link: https://convotrack.in/join/CODE
                 autoVerify checks /.well-known/assetlinks.json on EVERY host listed here, and
                 the check does not follow redirects — so both the apex and www are declared and
                 both must serve the file with a 200 and a matching signing fingerprint. Listing
                 only the apex, while the site 308s it to www, is a verification that silently
                 never succeeds and an invite link that opens a browser instead of the app.
                 Apex must match ApiClient.JOIN_LINK_HOST. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="convotrack.in"
                    android:pathPrefix="/join" />
                <data android:scheme="https"
                    android:host="www.convotrack.in"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <!-- Hands the shareable ride-summary image to other apps. A raw file:// URI would be
             rejected by the OS (FileUriExposedException); the receiving app reads this through a
             one-shot read grant attached to the share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Broadcasts the rider's position during an active ride. -->
        <service
            android:name=".data.location.RideLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
