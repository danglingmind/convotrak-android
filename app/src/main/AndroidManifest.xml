<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only network reachability for the header connection indicator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A location foreground service lets the ride keep broadcasting position while
         backgrounded, using only the foreground ("while using") location grant. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR scanning for joining a ride. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".ConvoTrackApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="ConvoTrack"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConvoTrack">

        <!-- Maps SDK for Android key (injected from local.properties via manifestPlaceholders). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Meta SDK: started by MetaEvents, never by itself. Its init provider would run before
             Application.onCreate with no app id (the id comes from BuildConfig, not the
             manifest), and the auto-* flags would otherwise start logging on a build where Meta
             is meant to be off (no key, debug, or the rider has opted out). -->
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ConvoTrack"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Legacy deep link: convotrack://join/INVITECODE (QR back-compat) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="convotrack" android:host="join" />
            </intent-filter>

            <!-- HTTPS App Link: https://convotrack.in/join/CODE
                 autoVerify fetches /.well-known/assetlinks.json from every host listed here and
                 does not follow redirects, so each one must answer 200 with a matching signing
                 fingerprint. On Android 11 and below it is all-or-nothing: a single host that
                 fails takes the rest down with it.

                 Hence the apex ALONE, deliberately. It is the host every invite link and QR code
                 is built from (ApiClient.JOIN_LINK_HOST) and must therefore be the one that
                 verifies, which in turn means it is the host that must not redirect. Adding www
                 here would only work if www also served the file directly — and if www redirects
                 to the apex, as a canonical setup normally has it, listing it would break the
                 apex too on every device below Android 12. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="convotrack.in"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <!-- Hands the shareable ride-summary image to other apps. A raw file:// URI would be
             rejected by the OS (FileUriExposedException); the receiving app reads this through a
             one-shot read grant attached to the share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Broadcasts the rider's position during an active ride. -->
        <service
            android:name=".data.location.RideLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
