<?xml version="1.0" encoding="utf-8"?>
<!--
  The API 26-30 counterpart of data_extraction_rules.xml, which the platform only reads from
  API 31. Same reasoning: the session store must not travel, and nothing else here is worth
  carrying. Kept in step with that file by hand — the platform gives no way to share one.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
